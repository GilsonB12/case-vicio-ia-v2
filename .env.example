OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# modelos usados na execução canônica; outro modelo não acha o cache commitado e exige as chaves
MODELO_OPENAI=gpt-5-mini
MODELO_ANTHROPIC=claude-sonnet-5-5
MODELO_EMBEDDINGS=text-embedding-3-large
# auto tenta o Weaviate e cai para o índice em memória; sim exige o Weaviate; nao usa só a memória
USAR_WEAVIATE=auto
WEAVIATE_URL=http://localhost:8081
